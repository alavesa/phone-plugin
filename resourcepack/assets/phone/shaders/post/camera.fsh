#version 330
#extension GL_ARB_separate_shader_objects : require

// =====================================================================================================================
// phone:camera_<zoom>  -  the camera viewfinder: digital zoom + frame overlay.
//
// What it does
//   1. Zoom: magnifies the centre of the rendered world by the Zoom factor (the picture is sampled closer to the
//      centre, like the digital zoom of a real phone). The client's real field of view is NOT changed, so entity
//      and chunk culling behave as usual; the price is that the picture gets blurrier at high zoom.
//   2. Viewfinder: darkens everything outside the central square (the part that ends up in the 128x128 photo -
//      the server renders exactly this square with the same zoom factor), draws corner brackets, rule-of-thirds
//      lines and one pip per zoom level along the top (pips up to the current level are lit).
//
// How it is triggered
//   The pack has one post_effect JSON per zoom level (camera_1.json, camera_2.json ...; generated by
//   tools/gen_pack.py). The plugin swaps the id on the player with Player.postEffects() when the zoom changes.
//
// What it cannot do
//   Post effects run before the HUD and the held item are drawn: the vanilla crosshair and hotbar stay on top,
//   unzoomed. The plugin hides the phone model in first person while the camera is open (items/phone_camera.json).
// =====================================================================================================================

const float OUTSIDE_DIM = 0.30;         // brightness of the picture outside the photo square
const float BRACKET_INSET = 0.045;      // distance of the corner brackets from the square's edge, in screen heights
const float BRACKET_LENGTH = 0.085;     // length of each bracket arm, in screen heights
const float THIRDS_ALPHA = 0.14;        // opacity of the rule-of-thirds lines
const float PIP_SIZE = 0.011;           // half size of a zoom pip, in screen heights
const float PIP_SPACING = 0.038;        // distance between pips, in screen heights
const float PIP_Y = 0.075;              // distance of the pip row from the top edge, in screen heights (the hotbar covers the bottom)
const vec3 FRAME_COLOUR = vec3(1.0, 1.0, 1.0);
const vec3 PIP_COLOUR = vec3(1.0, 0.82, 0.25);

uniform sampler2D InSampler;

layout(std140) uniform SamplerInfo {
    vec2 OutSize;
    vec2 InSize;
};

// Values from the post_effect JSON.
layout(std140) uniform CameraConfig {
    float Zoom;         // magnification, 1 = none
    float Level;        // index of this zoom level, 0-based
    float Levels;       // number of zoom levels the pack has (pips drawn)
    float Frame;        // 1 = draw the viewfinder overlay, 0 = zoom only
};

layout(location = 0) in vec2 texCoord;

layout(location = 0) out vec4 fragColor;

// 1 inside the axis-aligned box [lo, hi], else 0
float box(vec2 p, vec2 lo, vec2 hi) {
    vec2 s = step(lo, p) * step(p, hi);
    return s.x * s.y;
}

void main() {
    // --- zoom: sample closer to the centre --------------------------------------------------------------------------
    vec2 uv = 0.5 + (texCoord - 0.5) / max(Zoom, 1.0);
    vec3 col = texture(InSampler, uv).rgb;

    if (Frame > 0.5) {
        // p: position in screen heights, origin at the centre of the screen, +y up. The photo square is |p| <= 0.5.
        vec2 p = (texCoord - 0.5) * vec2(OutSize.x / OutSize.y, 1.0);
        float px = 1.0 / OutSize.y;                         // one screen pixel
        float thick = max(1.0, floor(OutSize.y / 360.0)) * px;   // line width: 1 GUI-ish pixel

        // outside the square: dimmed
        if (abs(p.x) > 0.5) {
            col *= OUTSIDE_DIM;
        }

        // corner brackets (mirrored into one quadrant)
        vec2 q = abs(p);
        float edge = 0.5 - BRACKET_INSET;
        float bracket = box(q, vec2(edge - BRACKET_LENGTH, edge - thick), vec2(edge, edge))
                      + box(q, vec2(edge - thick, edge - BRACKET_LENGTH), vec2(edge, edge));
        col = mix(col, FRAME_COLOUR, clamp(bracket, 0.0, 1.0) * 0.9);

        // rule of thirds, inside the brackets only
        float thirds = (step(abs(q.x - 1.0 / 6.0), thick * 0.5) + step(abs(q.y - 1.0 / 6.0), thick * 0.5))
                     * box(q, vec2(0.0), vec2(edge - thick));
        col = mix(col, FRAME_COLOUR, clamp(thirds, 0.0, 1.0) * THIRDS_ALPHA);

        // zoom pips: Levels small squares centred along the top; filled up to the current level, outlined after
        float count = max(Levels, 1.0);
        float first = -0.5 * (count - 1.0) * PIP_SPACING;
        float index = clamp(floor((p.x - first) / PIP_SPACING + 0.5), 0.0, count - 1.0);
        vec2 d = abs(p - vec2(first + index * PIP_SPACING, 0.5 - PIP_Y));
        float inside = step(max(d.x, d.y), PIP_SIZE);
        float ring = inside * step(PIP_SIZE - thick, max(d.x, d.y));
        float lit = step(index, Level + 0.5);
        col = mix(col, mix(FRAME_COLOUR, PIP_COLOUR, lit), mix(ring * 0.8, inside, lit));
    }

    fragColor = vec4(col, 1.0);
}
